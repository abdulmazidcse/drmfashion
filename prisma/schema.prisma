generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}
enum Role {
  USER
  ADMIN
  /// Admin-panel user whose access is limited by `User.adminRole` permissions.
  STAFF
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum MeasurementSurchargeType {
  FLAT
  PERCENT
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  password    String
  phone       String?
  role        Role        @default(USER)
  /// Permission set for STAFF users. ADMIN ignores it (full access); USER never
  /// reaches the admin panel. See lib/permissions.ts.
  adminRoleId String?
  adminRole   AdminRole?  @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  rewardPoints Int        @default(0)

  /// Bumped to revoke every JWT already issued to this user — the admin
  /// "Force Logout" action. Tokens carry the value they were signed with and
  /// are rejected once it no longer matches (see lib/auth.ts).
  tokenVersion Int        @default(0)

  /// Deactivated accounts cannot log in and any live session is rejected on the
  /// next request. Force Logout only ends the current session — this is what
  /// stops the account from signing straight back in.
  isActive    Boolean     @default(true)

  /// Self-service account deletion. The row survives because orders, payments
  /// and returns reference it and the shop still needs its own records; the
  /// personal details are overwritten instead. See /api/customer/account DELETE.
  deletedAt   DateTime?

  /// Set once the customer enters the code mailed to them at sign-up. Login is
  /// refused until it is set, which is what stops accounts being opened on
  /// addresses that do not exist. Google sign-ins are stamped immediately —
  /// Google has already proven the address — and guest-checkout rows never log
  /// in at all, so they are unaffected.
  emailVerifiedAt DateTime?

  addresses   Address[]
  cart        Cart?
  wishlist    Wishlist?
  reviews     Review[]
  questions   ProductQuestion[]
  orders      Order[]
  returnRequests ReturnRequest[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Address {
  id          String    @id @default(cuid())

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  fullName    String
  phone       String

  country     String
  city        String
  area        String
  address     String
  postalCode  String?

  isDefault   Boolean   @default(false)

  createdAt   DateTime  @default(now())
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  /// Portrait tile (≈5:7) — the Trending / Summer / Winter grids, the admin
  /// list and the category cards all render this one.
  image       String?

  /// Wide artwork (≈3:1) for the top of /category/[slug]. Separate from
  /// `image` because the same photo cannot serve both a 5:7 tile and a 3:1
  /// banner without one of them being cropped to nonsense.
  bannerImage String?

  /// Alt text for the two pictures above. Empty falls back to a line built from
  /// the category name — see categoryImageAlt in lib/imageMeta.ts. Separate
  /// fields because they are separate photographs.
  imageAlt       String?
  bannerImageAlt String?

  /// Optional visible caption printed under each picture. Unlike alt there is
  /// no generated fallback: an invented caption would be visible copy nobody
  /// wrote, so empty simply renders nothing.
  imageCaption       String?
  bannerImageCaption String?

  description String?     @db.Text
  isTrending  Boolean     @default(false)

  /// Search-engine overrides for /category/[slug]. Empty falls back to the
  /// category name and description — see that page's generateMetadata.
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?  @db.Text

  /// "How to measure" copy for the size guide, inherited up the category chain
  /// — see lib/sizeChart.ts. Independent of which SizeChart a product points
  /// at, so one guide written on "Men" covers every shirt beneath it. Rich text
  /// (HTML) from the admin editor.
  howToMeasure String? @db.Text
  /// The body illustration shown beside that copy (numbered figure). Inherits
  /// up the chain the same way; empty falls back to the built-in drawing.
  howToMeasureImage String?

  parentId    String?
  parent      Category?   @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryChildren")

  products    Product[]

  createdAt   DateTime    @default(now())
  deletedAt   DateTime?
}

/// A named, reusable size chart — "Men's Tops", "Women's Denim" — written once
/// in Admin → Size Charts and pointed at by any number of products.
///
/// `table` holds the same shape the editor and storefront already speak:
/// { title, unit: "in" | "cm", columns: string[], rows: string[][] }
/// Values are stored in ONE unit; the storefront toggle converts on the fly.
model SizeChart {
  id          String      @id @default(cuid())
  name        String      @unique
  table       Json

  products    Product[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Brand {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  image       String?
  description String?     @db.Text

  products    Product[]

  createdAt   DateTime    @default(now())
}

model Color {
  id          String      @id @default(cuid())
  name        String
  // SOLID | GRADIENT | CHECK | IMAGE — see lib/colorStyle.ts for how each renders
  type        String      @default("SOLID")
  // always set: the flat colour, and the fallback behind an IMAGE swatch
  value       String
  // gradient: second stop. check: line colour over `value`
  value2      String?
  // gradient direction in degrees
  angle       Int?
  // IMAGE: fabric / print photo cropped into the swatch
  image       String?

  createdAt   DateTime    @default(now())
}

model Size {
  id          String      @id @default(cuid())
  name        String
  value       String      @unique

  packages    SizePackage[]

  createdAt   DateTime    @default(now())
}

/// A named subset of sizes, so the variant form can offer "Menswear Tops"
/// (S–2XL) instead of the full 35-size list. Purely an authoring convenience —
/// nothing references it from a Product; the sizes still live on the variants.
model SizePackage {
  id          String      @id @default(cuid())
  name        String      @unique
  sizes       Size[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Length {
  id          String      @id @default(cuid())
  name        String
  value       String      @unique

  createdAt   DateTime    @default(now())
}

model Product {
  id              String            @id @default(cuid())

  title           String
  /// Merchant-facing code, unique across the catalogue. Titles are deliberately
  /// NOT unique — two products may share one — so this is what identifies a
  /// product to staff, and the slug is built from it to stay collision-free.
  /// Nullable because products created before this field existed have none.
  productCode     String?           @unique
  slug            String            @unique
  description     String            @db.Text
  sizeAndFit      String?           @db.Text
  fabricAndCare   String?           @db.Text

  metaTitle       String?
  metaDescription String?           @db.Text
  metaKeywords    String?           @db.Text
  tags            String?           @db.Text

  brandId         String?
  brand           Brand?            @relation(fields: [brandId], references: [id])
  thumbnail       String

  /// The size chart this product shows, picked in Admin → Products. Null means
  /// no chart is offered — there is no inheritance, so the choice is explicit.
  sizeChartId     String?
  sizeChart       SizeChart?        @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)

  basePrice       Float
  costPrice       Float?
  discountPrice   Float?
  flashSaleEndDate DateTime?

  featured        Boolean           @default(false)
  published       Boolean           @default(true)

  // ─── Made-to-measure ───────────────────────────────────────────────────────
  // When enabled the customer can order this product to their own measurements.
  // The surcharge falls back to the template's unless overridden here.
  customMeasurementEnabled Boolean                   @default(false)
  measurementTemplateId    String?
  measurementTemplate      MeasurementTemplate?      @relation(fields: [measurementTemplateId], references: [id], onDelete: SetNull)
  customSurchargeType      MeasurementSurchargeType?
  customSurchargeValue     Float?

  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])

  /// The item the model has on with this one, shown as "Model is also wearing"
  /// on the product page. Curated — the section is hidden when this is null,
  /// rather than falling back to a guessed related product.
  modelWearsProductId String?
  modelWearsProduct   Product?      @relation("ModelWears", fields: [modelWearsProductId], references: [id], onDelete: SetNull)
  modelWornWith       Product[]     @relation("ModelWears")

  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  questions       ProductQuestion[]
  collections     CollectionProduct[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  // Every admin and storefront listing filters on `deletedAt IS NULL` and sorts
  // by `createdAt DESC`; the category filter drives the shop and the admin
  // category picker. Postgres does not index foreign keys automatically.
  @@index([deletedAt, createdAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([modelWearsProductId])
}

model ProductImage {
  id          String    @id @default(cuid())

  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  url         String
  color       String?

  /// Alt text for this specific shot. Empty falls back to a generated one built
  /// from the product title, its colourway and the shot's position — see
  /// lib/imageMeta.ts. Written for a reader who cannot see the image, so it
  /// describes the garment rather than repeating the file name.
  alt         String?

  /// Optional visible caption rendered under the image in the gallery. Google
  /// Images reads the text surrounding a picture, so this is indexable copy as
  /// well as something a shopper reads — most images want none.
  caption     String?   @db.Text
}

model ProductVariant {
  id              String          @id @default(cuid())

  productId       String
  product         Product         @relation(fields: [productId], references: [id])

  size            String
  color           String
  length          String?
  sku             String          @unique

  stock           Int
  price           Float?

  image           String?
  images          Json

  orderItems      OrderItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]

  inventoryLogs   InventoryLog[]
  purchaseItems   PurchaseOrderItem[]
  stockAlerts     StockAlert[]

  createdAt       DateTime        @default(now())
  deletedAt       DateTime?

  @@index([productId])
  @@index([sku])

  // The inventory screen pages through variants ordered by stock and filters on
  // low/out-of-stock bands, so the sort key needs an index of its own.
  @@index([deletedAt, stock])
}

model Cart {
  id          String      @id @default(cuid())

  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id])

  items       CartItem[]

  createdAt   DateTime    @default(now())
}

model CartItem {
  id              String            @id @default(cuid())

  cartId          String
  cart            Cart              @relation(fields: [cartId], references: [id])

  variantId       String
  variant         ProductVariant    @relation(fields: [variantId], references: [id])

  quantity        Int

  createdAt       DateTime          @default(now())
}

model Wishlist {
  id          String          @id @default(cuid())

  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id])

  items       WishlistItem[]
}

model WishlistItem {
  id              String            @id @default(cuid())

  wishlistId      String
  wishlist        Wishlist          @relation(fields: [wishlistId], references: [id])

  variantId       String
  variant         ProductVariant    @relation(fields: [variantId], references: [id])

  createdAt       DateTime          @default(now())
}

model Order {
  id                  String            @id @default(cuid())

  userId              String
  user                User              @relation(fields: [userId], references: [id])

  totalAmount         Float

  status              OrderStatus       @default(PENDING)

  paymentStatus       PaymentStatus     @default(PENDING)

  shippingAddress     String
  shippingPhone       String
  shippingCarrier     String?
  shippingMethod      String?
  shippingFee         Float             @default(0)
  // ─── Delivery tracking ───────────────────────────────────────────────────
  // Set from Admin → Deliveries. `trackingUrl` is resolved from the carrier's
  // template in settings when the number is saved, so the customer page never
  // has to know about carriers.
  trackingNumber      String?
  trackingUrl         String?
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  deliveryNote        String?

  /// Destination region, used to pick the tax rate. Stored separately from the
  /// flattened `shippingAddress` string so reports can group by province.
  shippingState       String?
  shippingCountry     String?

  /// Tax as charged, frozen at order time. The rate and label are snapshots for
  /// the same reason `shippingFee` is: editing a rate in Admin later must not
  /// rewrite what an old invoice says was collected.
  taxAmount           Float             @default(0)
  taxRate             Float             @default(0)
  taxLabel            String?

  items               OrderItem[]

  payment             Payment?
  returnRequests      ReturnRequest[]
  
  pointsRedeemed      Int               @default(0)
  pointsEarned        Int               @default(0)

  currencyCode        String            @default("USD")
  currencySymbol      String            @default("$")
  exchangeRate        Float             @default(1.0)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                  String            @id @default(cuid())

  orderId             String
  order               Order             @relation(fields: [orderId], references: [id])

  variantId           String
  variant             ProductVariant    @relation(fields: [variantId], references: [id])

  quantity            Int
  price               Float

  // ─── Made-to-measure snapshot ──────────────────────────────────────────────
  // Values and fee are frozen at order time so later admin edits to a template
  // never rewrite the price or measurements of an existing order.
  isCustom            Boolean           @default(false)
  customFee           Float             @default(0)
  customMeasurements  Json?             // { templateName, unit, values: [{ key, label, value, unit }] }

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                  String            @id @default(cuid())

  orderId             String            @unique
  order               Order             @relation(fields: [orderId], references: [id])

  transactionId       String?

  provider            String

  amount              Float

  status              PaymentStatus     @default(PENDING)

  createdAt           DateTime          @default(now())
}

model Review {
  id              String      @id @default(cuid())

  userId          String
  user            User        @relation(fields: [userId], references: [id])

  productId       String
  product         Product     @relation(fields: [productId], references: [id])

  rating          Int
  comment         String?

  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model Coupon {
  id              String      @id @default(cuid())

  code            String      @unique

  type            CouponType  @default(PERCENTAGE)
  discount        Float

  minOrderAmount  Float?      // Minimum order value to apply coupon
  maxUses         Int?        // Max number of times coupon can be used (null = unlimited)
  usedCount       Int         @default(0)

  active          Boolean     @default(true)

  /// When true the code only works for an email that is in the Subscriber
  /// table. This is what makes a "sign up and get 15% off" code actually
  /// require the sign-up — checkout matches the order's email against it.
  subscribersOnly Boolean     @default(false)

  /// Restricts the code to someone who has never ordered before — the other
  /// half of "15% off your first order". Checked against the email on the
  /// order, so guest checkouts count too.
  firstOrderOnly  Boolean     @default(false)

  expiresAt       DateTime?
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  /// Optional portrait crop for small screens; falls back to `image`.
  mobileImage String?
  link        String?
  buttonText  String?
  /// Where the storefront renders it. See BANNER_POSITIONS in lib/banners.ts.
  position    String    @default("home_top")
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  /// Optional schedule; null means always.
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([position, active, sortOrder])
}

/// Curated, merchandised groups of products ("Summer Edit", "Wedding Guest").
/// Independent of the category tree: a product belongs to exactly one category
/// but can sit in any number of collections.
model Collection {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String?             @db.Text
  /// Portrait tile used in listings.
  image           String?
  /// Wide artwork for the top of /collection/[slug].
  bannerImage     String?
  active          Boolean             @default(true)
  featured        Boolean             @default(false)
  sortOrder       Int                 @default(0)
  metaTitle       String?
  metaDescription String?             @db.Text
  startsAt        DateTime?
  endsAt          DateTime?
  products        CollectionProduct[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([active, sortOrder])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@id([collectionId, productId])
  @@index([productId])
}

model ReturnRequest {
  id              String        @id @default(cuid())

  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])

  userId          String
  user            User          @relation(fields: [userId], references: [id])

  reason          String
  status          ReturnStatus  @default(PENDING)
  adminNote       String?
  // ─── Refund record ───────────────────────────────────────────────────────
  // Filled in when the request moves to REFUNDED. `refundMethod` is "stripe"
  // when the money went back through the gateway, "manual" for cash / bank /
  // COD refunds handled outside the system.
  refundAmount        Float?
  refundMethod        String?
  refundTransactionId String?
  refundedAt          DateTime?
  /// Whether the returned units were put back into variant stock.
  restocked           Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model Subscriber {
  id              String      @id @default(cuid())

  email           String      @unique
  firstName       String?
  shopFor         String?

  subscribedAt    DateTime    @default(now())
}

// Messages submitted through the storefront "Contact Us" form.
model ContactMessage {
  id          String      @id @default(cuid())
  name        String
  email       String
  subject     String?
  message     String
  handled     Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([createdAt])
}

// One-time password codes for customer "forgot password" reset flow.
// OTP is stored hashed; rows are short-lived and cleaned up on use/expiry.
/// One-time codes mailed to a customer. Despite the name it now serves two
/// flows — see `purpose`. Kept under the original name so the existing table
/// and its rows survive.
model PasswordResetOtp {
  id          String      @id @default(cuid())
  email       String
  otpHash     String

  /// "PASSWORD_RESET" or "EMAIL_VERIFICATION". Codes are scoped to a purpose so
  /// a reset code cannot be used to verify an address, or the other way round.
  purpose     String      @default("PASSWORD_RESET")

  expiresAt   DateTime
  attempts    Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([email, purpose])
}

model InventoryLog {
  id              String            @id @default(cuid())

  variantId       String
  variant         ProductVariant    @relation(fields: [variantId], references: [id])

  previousStock   Int
  newStock        Int

  note            String?

  createdAt       DateTime          @default(now())

  @@index([variantId])
  @@index([createdAt])
}

model Supplier {
  id              String            @id @default(cuid())
  
  name            String
  email           String?
  phone           String?
  address         String?
  
  purchaseOrders  PurchaseOrder[]
  expenses        Expense[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PurchaseOrder {
  id              String            @id @default(cuid())
  
  supplierId      String
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  
  status          PurchaseOrderStatus @default(DRAFT)
  
  totalCost       Float
  
  items           PurchaseOrderItem[]
  
  notes           String?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PurchaseOrderItem {
  id              String            @id @default(cuid())
  
  purchaseOrderId String
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  
  variantId       String
  variant         ProductVariant    @relation(fields: [variantId], references: [id])
  
  quantity        Int
  unitCost        Float
  
  createdAt       DateTime          @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   // Stores HTML content
  published Boolean  @default(true)

  /// Search-engine overrides for /pages/[slug]. Empty falls back to the page
  /// title and the opening text of the body — see that page's generateMetadata.
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductQuestion {
  id          String   @id @default(cuid())

  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  userName    String?  // For guest questions

  question    String
  answer      String?

  status      String   @default("PENDING") // PENDING, ANSWERED, REJECTED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model StockAlert {
  id        String   @id @default(cuid())
  email     String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, NOTIFIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, variantId])
}

model MenuItem {
  id         String     @id @default(cuid())
  title      String
  url        String
  position   Int        @default(0)
  imageUrl   String?
  parentId   String?
  parent     MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   MenuItem[] @relation("MenuHierarchy")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// A made-to-measure garment type (Shirt, Pant, Blazer …) plus the tailoring
/// surcharge charged when a customer orders it to their own measurements.
model MeasurementTemplate {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  description    String?                  @db.Text
  instructions   String?                  @db.Text // "How to measure" copy shown to the customer

  surchargeType  MeasurementSurchargeType @default(FLAT)
  surchargeValue Float                    @default(0)

  active         Boolean                  @default(true)
  position       Int                      @default(0)

  fields         MeasurementField[]
  products       Product[]

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

/// One measurement the customer fills in (Shoulder, Chest …).
model MeasurementField {
  id         String              @id @default(cuid())

  templateId String
  template   MeasurementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  label      String // "Shoulder"
  key        String // "shoulder" — stable key stored on the order
  unit       String              @default("in")
  helpText   String?
  placeholder String?

  minValue   Float?
  maxValue   Float?
  step       Float               @default(0.5)
  required   Boolean             @default(true)
  position   Int                 @default(0)

  /// Size-based upcharges ("Waist 41-42 → +$50"). Empty = no per-size pricing.
  tiers      MeasurementFieldTier[]

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([templateId, key])
  @@index([templateId])
}

/// One price bracket on a measurement field: when the customer's value falls
/// inside [minValue, maxValue] this surcharge is added on top of the template's
/// base tailoring fee. Ranges must not overlap — enforced in the admin API.
model MeasurementFieldTier {
  id             String                   @id @default(cuid())

  fieldId        String
  field          MeasurementField         @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  minValue       Float // 39
  maxValue       Float // 40 — inclusive on both ends
  surchargeType  MeasurementSurchargeType @default(FLAT)
  surchargeValue Float                    @default(0) // 45

  position       Int                      @default(0)

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([fieldId])
}

model JournalCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  position    Int           @default(0)

  posts       JournalPost[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model JournalPost {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  excerpt         String?          @db.Text
  content         String           @db.Text // Stores HTML content
  coverImage      String?

  authorName      String?
  readTime        Int              @default(1) // minutes, auto-estimated from content
  tags            String[]         @default([])

  featured        Boolean          @default(false)
  published       Boolean          @default(false)
  publishedAt     DateTime?
  views           Int              @default(0)

  metaTitle       String?
  metaDescription String?          @db.Text
  metaKeywords    String?

  categoryId      String?
  category        JournalCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
  @@index([featured])
}

// ─── Role based access control ───────────────────────────────────────────────

/// A named bundle of permissions ("Order Manager", "Content Editor"). The
/// permission keys are `<module>.<action>` strings validated against
/// PERMISSIONS in lib/permissions.ts; unknown keys are dropped on save.
model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  permissions String[] @default([])
  /// Seeded roles cannot be deleted, only edited.
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// ─── Accounting ──────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalSource {
  MANUAL
  ORDER
  PAYMENT
  REFUND
  PURCHASE
  EXPENSE
  ADJUSTMENT
}

/// Chart of accounts. `code` is the merchant-facing number (1000 Cash, 4000
/// Sales). System accounts are the ones auto-posting relies on and cannot be
/// deleted — see DEFAULT_ACCOUNTS in lib/accounting.ts.
model Account {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         AccountType
  description  String?
  isSystem     Boolean       @default(false)
  active       Boolean       @default(true)
  parentId     String?
  parent       Account?      @relation("AccountChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     Account[]     @relation("AccountChildren")
  lines        JournalLine[]
  expenses     Expense[]     @relation("ExpenseAccount")
  paidExpenses Expense[]     @relation("ExpensePaidFrom")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([type, active])
}

/// Double-entry journal. Every entry balances (sum debit == sum credit).
/// Auto-posted entries carry the source and the id of the row they came from,
/// which is what makes re-posting idempotent.
model JournalEntry {
  id            String        @id @default(cuid())
  entryNo       Int           @unique @default(autoincrement())
  date          DateTime      @default(now())
  memo          String?
  source        JournalSource @default(MANUAL)
  referenceType String?
  referenceId   String?
  createdById   String?
  lines         JournalLine[]
  expense       Expense?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@unique([source, referenceType, referenceId])
  @@index([date])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Float        @default(0)
  credit      Float        @default(0)
  description String?

  @@index([entryId])
  @@index([accountId])
}

/// Operating expenses recorded by staff (rent, ads, packaging…). Saving one
/// posts a journal entry: debit the expense account, credit the account it was
/// paid from.
model Expense {
  id                String        @id @default(cuid())
  date              DateTime      @default(now())
  accountId         String
  account           Account       @relation("ExpenseAccount", fields: [accountId], references: [id])
  paidFromAccountId String
  paidFromAccount   Account       @relation("ExpensePaidFrom", fields: [paidFromAccountId], references: [id])
  amount            Float
  vendor            String?
  supplierId        String?
  supplier          Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reference         String?
  note              String?       @db.Text
  receiptUrl        String?
  entryId           String?       @unique
  entry             JournalEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  @@index([date])
  @@index([accountId])
}
